# Variables de entorno del backend.
# Copia este archivo como backend/.env y completa los valores. backend/.env no se sube a git.
# En Render no se usa .env: estas variables se definen en el panel del servicio.

# "production" activa las comprobaciones de producción (JWT_SECRET y ADMIN_PASSWORD obligatorias).
# En local déjala comentada.
# NODE_ENV=production

# Puerto del servidor (por defecto 3000; Render lo define solo).
# PORT=3000

# Secreto para firmar los JWT. Obligatorio en producción; usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Contraseña del usuario admin. Se aplica en cada arranque. Obligatoria en producción.
ADMIN_PASSWORD=cambia-esta-contraseña

# Si está definida, crea o actualiza la cuenta demo (rol entrenador) con esta contraseña.
DEMO_PASSWORD=demo1234

# Borra los datos de visitantes con más de estos minutos (en Render: 10).
# Sin ella no se borra nada; en local suele convenir dejarla comentada.
# DEMO_LIMPIEZA_MINUTOS=10

# Ruta de la base de trabajo, relativa a backend/ (por defecto database/pokebase.runtime.sqlite).
# DB_PATH=database/pokebase.runtime.sqlite
